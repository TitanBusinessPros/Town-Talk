rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/images/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /businesses/{uid}/images/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /chatSponsorLogos/{uid}/images/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Daily Rewards sponsor logos — uploaded by an admin via the giveaway
    // creation form, not by the sponsor (sponsors never get a Town Fuss
    // account of their own, just their scoped verification portal login).
    // Admin check is a cross-service Firestore lookup since Storage rules
    // don't have their own concept of an admins collection.
    match /dailyRewardLogos/{sponsorId}/images/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null
                    && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }
  }
}
