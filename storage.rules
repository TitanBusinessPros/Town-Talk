rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/images/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /businesses/{uid}/images/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /chatSponsorLogos/{uid}/images/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Daily Rewards sponsor logos — uploaded by an admin via the giveaway
    // creation form, not by the sponsor (sponsors never get a Town Fuss
    // account of their own, just their scoped verification portal login).
    // Admin check is a custom claim (request.auth.token.admin), kept in
    // sync with the admins/{uid} Firestore collection by the
    // syncAdminClaim Cloud Function — NOT a cross-service
    // firestore.exists() lookup, which is what this used to be. That
    // version was syntactically correct but kept failing at runtime for
    // a confirmed real admin (never fully root-caused); custom claims
    // are also just the pattern Firebase recommends for this exact
    // "does Storage rules know about a role" problem, so this is the
    // real fix, not a workaround for the old one.
    match /dailyRewardLogos/{sponsorId}/images/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.token.admin == true
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
