rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    // Broadcast-style writes (chat rooms, DMs) denormalize the sender's own
    // name/photo onto the message doc at write time, so an unapproved
    // profile's content can otherwise reach other users before admin review
    // ever happens. Gate those writes on the SAME approved flag the
    // Directory/Feed already require to read a profile.
    function isApproved(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.get('approved', false) == true;
    }
    function today() {
      return int(request.time.toMillis() / 86400000);
    }
    // Membership fields (granted only by the Stripe webhook via the Admin
    // SDK, which bypasses rules entirely) must never be settable by the
    // user themselves — false/absent on create, and unchanged on any
    // owner-initiated update to their own users/{uid} doc, including the
    // "re-submit for review" self-edit path which otherwise doesn't
    // restrict which other fields can change.
    function membershipFieldsUntouched() {
      return request.resource.data.get('isGoldMember', false) == false
          && request.resource.data.get('isDiamondMember', false) == false;
    }
    function membershipFieldsUnchanged() {
      return request.resource.data.get('isGoldMember', false) == resource.data.get('isGoldMember', false)
          && request.resource.data.get('goldExpiresAt', null) == resource.data.get('goldExpiresAt', null)
          && request.resource.data.get('isDiamondMember', false) == resource.data.get('isDiamondMember', false)
          && request.resource.data.get('diamondExpiresAt', null) == resource.data.get('diamondExpiresAt', null)
          && request.resource.data.get('stripeCustomerId', null) == resource.data.get('stripeCustomerId', null);
    }
    // Daily-cap lookups for direct messages and online game plays — separate
    // numbers per category since 2026-08-07 (used to share one number).
    // Applies to every edition (production, Eufaula Lake, and any future
    // clone) since this file is deployed identically to each. Reads the
    // user's OWN membership flags — safe from tampering since those fields
    // can never be client-written (see above).
    function dailyMessageLimit(uid) {
      let userData = get(/databases/$(database)/documents/users/$(uid)).data;
      return userData.get('isDiamondMember', false) ? 999999999
           : (userData.get('isGoldMember', false) ? 30 : 10);
    }
    function dailyGamePlayLimit(uid) {
      let userData = get(/databases/$(database)/documents/users/$(uid)).data;
      return userData.get('isDiamondMember', false) ? 999999999
           : (userData.get('isGoldMember', false) ? 15 : 5);
    }
    // A chat message's optional reply-quote fields. No reply fields at all
    // (the common case — most messages aren't replies) is always valid.
    // If present, all four must be present together and replyToSenderId
    // must actually match the real sender of replyToMessageId in the SAME
    // room — otherwise someone could forge "so-and-so replied to your
    // message" notifications pointing at a message that isn't theirs, or
    // quote text that was never actually said. One extra read (the
    // replied-to message itself), only on replies.
    function isValidChatReply(roomId, data) {
      return !data.keys().hasAny(['replyToMessageId', 'replyToSenderId', 'replyToSenderName', 'replyToText']) || (
        data.keys().hasAll(['replyToMessageId', 'replyToSenderId', 'replyToSenderName', 'replyToText'])
        && data.replyToMessageId is string
        && data.replyToSenderId is string
        && data.replyToSenderName is string
        && data.replyToText is string && data.replyToText.size() <= 120
        && exists(/databases/$(database)/documents/chatRooms/$(roomId)/messages/$(data.replyToMessageId))
        && get(/databases/$(database)/documents/chatRooms/$(roomId)/messages/$(data.replyToMessageId)).data.senderId == data.replyToSenderId
      );
    }

    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    match /leaderboardCache/{docId} {
      allow read: if isSignedIn();
      allow write: if false; // only the scheduled Cloud Function writes this, via Admin SDK
    }

    match /spotlights/{weekId} {
      allow read: if isSignedIn();
      allow write: if false; // only the scheduled Cloud Function writes this, via Admin SDK
    }

    // Doc ID is the lowercased email address the admin wants to comp a
    // free business year to. A signed-in user may only ever read the doc
    // matching their OWN email (used at signup to check "am I on the
    // list?") — they can never browse who else is on it. Only admins
    // can add or remove entries.
    match /businessPromoWhitelist/{emailId} {
      allow read: if isAdmin()
                  || (isSignedIn() && request.auth.token.email != null
                      && request.auth.token.email.lower() == emailId);
      allow write: if isAdmin();
    }

    // A business listing is its own thing, completely separate from a
    // personal profile — doc ID is the OWNER's uid (one business listing
    // per account), but nothing here ever touches /users/{uid}.
    match /businesses/{uid} {
      // The READER must be approved too, not just the listing itself — an
      // unapproved account (signed in, terms agreed, email verified, but
      // never reviewed by an admin) could otherwise browse every approved
      // business/profile in the app via a direct Firestore read, bypassing
      // index.html's own client-side approval gate entirely (that gate
      // only hides the UI; it was never the actual security boundary).
      allow read: if (isSignedIn() && isApproved(request.auth.uid) && resource.data.approved == true) || isOwner(uid) || isAdmin();
      // businessPaidUntil is granted only by the Stripe webhook (Admin SDK,
      // bypasses rules) or an admin's manual "mark paid" — an owner editing
      // their own listing must never be able to change it, even via the
      // "resubmit for review" self-edit path below.
      // Auto-approval (2026-08-15): a brand-new listing is created already
      // approved by default now — nothing could possibly be SafeSearch-
      // flagged yet on a doc that doesn't exist until this exact write, so
      // unlike the update rule below there's no flag state to check here.
      allow create: if isOwner(uid)
                    && ((request.resource.data.approved == false && request.resource.data.everApproved == false)
                        || (request.resource.data.approved == true && request.resource.data.everApproved == true))
                    && (
                         request.resource.data.get('businessPaidUntil', null) == null
                         || (request.auth.token.email != null
                             && exists(/databases/$(database)/documents/businessPromoWhitelist/$(request.auth.token.email.lower())))
                       );
      allow update: if isAdmin()
                    || (isOwner(uid)
                        // Same auto-approval condition as users/{uid}'s
                        // matching branch — see its comment for the full
                        // reasoning (checks the CURRENT doc's SafeSearch flag,
                        // not anything the client supplies).
                        && (request.resource.data.approved == false
                            || (request.resource.data.approved == true
                                && request.resource.data.everApproved == true
                                && request.resource.data.get('rejected', false) == false
                                && resource.data.get('safeSearchFlag', {}).get('flagged', false) == false))
                        && request.resource.data.get('businessPaidUntil', null) == resource.data.get('businessPaidUntil', null)
                        // Same missing-whitelist gap as users/{uid} above: without
                        // this, ANY field was writable as long as approved stayed
                        // false and businessPaidUntil was untouched — restricted to
                        // just the fields the listing-edit/photo-upload flows
                        // actually touch.
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['name', 'phone', 'town', 'description', 'lastEditedAt', 'image', 'approved', 'everApproved', 'rejected']));
      allow delete: if isOwner(uid) || isAdmin();
    }

    match /businessReviewQueue/{uid} {
      allow read: if isAdmin();
      allow write: if (isOwner(uid) && request.auth.token.email_verified == true) || isAdmin();
    }

    // Chat room sponsorship — one active/pending submission per room,
    // reviewed by an admin before anyone gets invoiced (see index.js
    // comment and the admin panel's "Chat room sponsors" section; there's
    // no automated Stripe flow here, the admin invoices manually using the
    // email/months/total stored on the doc).
    match /chatSponsors/{roomId} {
      // Same audience as the chat rooms themselves — anyone who can see
      // the rooms can see who's sponsoring them.
      allow read: if isSignedIn() && (isApproved(request.auth.uid) || isAdmin());
      allow create: if isSignedIn() && isApproved(request.auth.uid)
                    && request.resource.data.submittedByUid == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow update: if isAdmin()
                    // Re-submitting for a room whose last sponsor was
                    // rejected — Firestore evaluates this as an UPDATE,
                    // not a create, since the doc already exists (same
                    // reasoning as the beforeSignInBlocking stub-transition
                    // branch on users/{uid} above). Anyone approved can
                    // claim a rejected/open slot, not just whoever
                    // submitted before.
                    || (isSignedIn() && isApproved(request.auth.uid)
                        && resource.data.status == 'rejected'
                        && request.resource.data.submittedByUid == request.auth.uid
                        && request.resource.data.status == 'pending');
      allow delete: if isAdmin();
    }
    match /chatSponsorReviewQueue/{roomId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && isApproved(request.auth.uid) && request.resource.data.submittedByUid == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // In-app notification bell. Only the Cloud Functions (via Admin SDK,
    // which bypasses rules) ever create these — a signed-in user can only
    // read their OWN notifications, and can only ever flip 'read' to true
    // on their own notification, nothing else.
    match /users/{uid}/notifications/{notifId} {
      allow read: if isOwner(uid) || isAdmin();
      allow update: if isOwner(uid)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if false;
    }

    match /users/{uid} {
      // Same reasoning as businesses/{uid} above — the READER must be
      // approved too, not just the profile being read.
      allow read: if (isSignedIn() && isApproved(request.auth.uid) && resource.data.approved == true) || isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
                    && request.resource.data.approved == false
                    && request.resource.data.everApproved == false
                    && membershipFieldsUntouched();
      allow update: if isAdmin()
                    // Completing a beforeSignInBlocking-created stub (see
                    // index.js) into a real profile. That blocking function
                    // stamps lastKnownIp onto users/{uid} via a merge write
                    // on EVERY sign-in — including the very first one,
                    // before either signup flow's own setDoc(..., {merge:
                    // true}) ever runs. By the time the client writes, the
                    // doc already "exists" (just the stub), so Firestore
                    // evaluates that write as an update against the create
                    // rule above, not a create — hasOnly() check below
                    // scopes this to ONLY that one-time transition (a real,
                    // already-submitted profile always has far more keys
                    // than just lastKnownIp), with the same requirements
                    // the create rule imposes.
                    || (isOwner(uid)
                        && resource.data.keys().hasOnly(['lastKnownIp'])
                        && request.resource.data.approved == false
                        && request.resource.data.everApproved == false
                        && membershipFieldsUntouched())
                    // Profile/post/photo edits (the "Basics" form, post submission,
                    // and photo upload) — covers both a never-yet-approved person
                    // completing their profile for the first time AND an
                    // already-approved person editing. Explicitly whitelisted to
                    // just the fields those three flows actually touch: without
                    // this hasOnly(), ANY field write here would pass as long as
                    // the approved condition below held — a wide-open door to
                    // every other field including game stats/high scores, not
                    // just profile/post/photo.
                    //
                    // Auto-approval (2026-08-15): a self-owner write is allowed
                    // to set approved: true directly now — admin review is no
                    // longer required for every submission, only when
                    // checkImageSafeSearch (index.js) has an active flag sitting
                    // on the CURRENT doc (resource.data, not the client-supplied
                    // request.resource.data — a client can't just claim it isn't
                    // flagged to bypass this). everApproved/rejected must move
                    // together with approved in that same write, matching
                    // exactly what index.html's own self-approve path sends.
                    || (isOwner(uid)
                        && (request.resource.data.approved == false
                            || (request.resource.data.approved == true
                                && request.resource.data.everApproved == true
                                && request.resource.data.get('rejected', false) == false
                                && resource.data.get('safeSearchFlag', {}).get('flagged', false) == false))
                        && membershipFieldsUnchanged()
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['profile', 'lastEditedAt', 'postText', 'postWordCount', 'lastImageEditedAt', 'images', 'approved', 'everApproved', 'rejected']))
                    // Administrative/consent fields — always writable regardless of
                    // approval status. lastActiveAt is a login heartbeat, and
                    // agreedToTerms/agreedToTermsAt has to stay writable even before
                    // approval or an updated Terms of Service could permanently lock
                    // an unapproved person out of ever re-agreeing (the terms gate on
                    // the client blocks the whole dashboard, approval status or not,
                    // until this is set).
                    || (isOwner(uid)
                        && membershipFieldsUnchanged()
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['lastActiveAt', 'agreedToTerms', 'agreedToTermsAt']))
                    // Daily Rewards opt-in toggle — its own dedicated branch,
                    // deliberately NOT gated on isApproved(uid) the way
                    // notificationsEnabled below is. Someone should be able to
                    // turn this on the moment they create their profile, before
                    // an admin has reviewed anything — that's the whole point of
                    // it living on the profile page instead of, say, a
                    // post-approval settings screen.
                    || (isOwner(uid)
                        && membershipFieldsUnchanged()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dailyRewards']))
                    // Actual platform-usage stats (game points/wins/losses, high
                    // scores, friend count, notification settings) — gated on
                    // approval, same "no platform access before approval" policy as
                    // chat/DMs/game creation above. An unapproved profile shouldn't
                    // be able to accumulate stats, appear on a leaderboard, or
                    // configure push notifications any more than it should be able
                    // to post in a chat room.
                    || (isOwner(uid)
                        && isApproved(uid)
                        && membershipFieldsUnchanged()
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['friendCount', 'lastActiveAt', 'agreedToTerms', 'agreedToTermsAt', 'chessPoints', 'chessWins', 'chessLosses', 'chessDraws', 'checkersPoints', 'checkersWins', 'checkersLosses', 'checkersDraws', 'wynneWarsPoints', 'wynneWarsWins', 'wynneWarsLosses', 'golfPoints', 'golfWins', 'golfLosses', 'golfDraws', 'fgPoints', 'fgWins', 'fgLosses', 'fgDraws', 'cribbagePoints', 'cribbageWins', 'cribbageLosses', 'match3BestScore', 'match3BestTimeMs', 'match3BestEfficiency', 'followBestRounds', 'followBestTimeMs', 'desertHighScore', 'sudokuBestStreak', 'neonDriftHighScore', 'gtfBestTimeMs', 'gravitySlingBestLevel', 'gravitySlingBestTimeMs', 'gravitySlingScore', 'dodgeHighScore', 'warPoints', 'warWins', 'warLosses', 'heartsPoints', 'heartsWins', 'heartsLosses', 'blackjackPoints', 'blackjackWins', 'blackjackLosses', 'blackjackDraws', 'airHockeyPoints', 'airHockeyWins', 'airHockeyLosses', 'deepSeaHighScore', 'titanSpaceHighScore', 'pongWins', 'blocksHighScore', 'stackCheckersPoints', 'stackCheckersWins', 'stackCheckersLosses', 'seaWarPoints', 'seaWarWins', 'seaWarLosses', 'notificationsEnabled', 'fcmTokens']));
      allow delete: if isOwner(uid) || isAdmin();
    }

    // Archived profiles from admin-initiated deletion (10-day restore
    // window) and the admin's own per-uid delete-rate-limit counter. Both
    // are only ever written by the adminDeleteProfile/adminRestoreProfile/
    // purgeExpiredDeletedProfiles Cloud Functions via the Admin SDK, which
    // bypasses rules entirely — so these only need a read rule for the
    // admin page to list the archive, nothing else.
    match /deletedUsers/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /adminDeleteLimits/{uid} {
      allow read, write: if false;
    }
    // Same as adminDeleteLimits above — Admin SDK only, via
    // adminGrantGold(), never touched directly by any client.
    match /adminGoldGrantLimits/{uid} {
      allow read, write: if false;
    }
    // IP ban list (doc ID = the IP address itself). Only ever written by
    // banUserAndIp() and read by beforeSignInBlocking() — both via the
    // Admin SDK, which bypasses rules entirely — plus read by the admin
    // Reports panel to show ban history. No client write path at all, ever:
    // an admin banning someone always goes through banUserAndIp(), never a
    // direct write, so there's nothing to allow here.
    match /blockedIPs/{ip} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /reviewQueue/{uid} {
      allow read: if isAdmin();
      allow write: if (isOwner(uid) && request.auth.token.email_verified == true) || isAdmin();
    }

    match /messageLimits/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
                   && request.resource.data.day == today()
                   && request.resource.data.count <= dailyMessageLimit(uid)
                   && (
                        (!exists(/databases/$(database)/documents/messageLimits/$(uid))
                          && request.resource.data.count == 1)
                        ||
                        (exists(/databases/$(database)/documents/messageLimits/$(uid))
                          && resource.data.day != today()
                          && request.resource.data.count == 1)
                        ||
                        (exists(/databases/$(database)/documents/messageLimits/$(uid))
                          && resource.data.day == today()
                          && request.resource.data.count == resource.data.count + 1)
                      );
    }

    // Rate-limits joining/creating ONLINE games (across every online game)
    // to dailyGamePlayLimit above — 5/day free, 15/day Gold, effectively
    // unlimited Diamond. Doc ID is just the uid (one shared counter across
    // every game, not per-game), written in the same batch as the
    // createTable()/joinTable() write it's gating.
    match /gamePlayLimits/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
                   && request.resource.data.day == today()
                   && request.resource.data.count <= dailyGamePlayLimit(uid)
                   && (
                        (!exists(/databases/$(database)/documents/gamePlayLimits/$(uid))
                          && request.resource.data.count == 1)
                        ||
                        (exists(/databases/$(database)/documents/gamePlayLimits/$(uid))
                          && resource.data.day != today()
                          && request.resource.data.count == 1)
                        ||
                        (exists(/databases/$(database)/documents/gamePlayLimits/$(uid))
                          && resource.data.day == today()
                          && request.resource.data.count == resource.data.count + 1)
                      );
    }

    // Rate-limits direct game invites to one per (inviter, invitee, game)
    // per hour — deters someone spamming the same person with repeat
    // invites. Doc ID convention: "<inviterUid>_<gameCollection>_<inviteeUid>",
    // enforced client-side by createTable()/createWynneTable() in each
    // game page, which write this in the same batch as the invite itself.
    // Not read directly by any client UI, only via get()/exists() below.
    match /gameInviteLimits/{limitId} {
      // Only the inviter can read their own cooldown records (so the app
      // can show "try again in X minutes" instead of a raw permission
      // error) — not read by anyone else directly, only via get()/exists()
      // from the game-creation rules above.
      allow read: if isSignedIn() && request.auth.uid == resource.data.inviterUid;
      allow create: if isSignedIn()
                    && request.resource.data.inviterUid == request.auth.uid
                    && limitId == request.auth.uid + '_' + request.resource.data.game + '_' + request.resource.data.inviteeUid
                    && request.resource.data.lastInvitedAt == request.time;
      allow update: if isSignedIn()
                    && resource.data.inviterUid == request.auth.uid
                    && request.resource.data.inviterUid == request.auth.uid
                    && request.resource.data.game == resource.data.game
                    && request.resource.data.inviteeUid == resource.data.inviteeUid
                    && request.resource.data.lastInvitedAt == request.time
                    && request.time > resource.data.lastInvitedAt + duration.value(1, 'h');
    }

    match /friendRequests/{pairId} {
      allow read: if isSignedIn()
                  && (resource == null || request.auth.uid in resource.data.participants);
      allow create: if isSignedIn()
                    && (isApproved(request.auth.uid) || isAdmin())
                    && request.auth.uid in request.resource.data.participants
                    && request.resource.data.participants.size() == 2
                    && request.resource.data.requestedBy == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow update: if isSignedIn()
                    && (isApproved(request.auth.uid) || isAdmin())
                    && request.auth.uid in resource.data.participants
                    && request.resource.data.participants == resource.data.participants
                    && resource.data.status == 'pending'
                    && request.resource.data.status == 'accepted'
                    && request.auth.uid != resource.data.requestedBy;
      allow delete: if isSignedIn() && request.auth.uid in resource.data.participants;
    }

    match /blocks/{pairId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn()
                    && request.auth.uid in request.resource.data.participants
                    && request.resource.data.participants.size() == 2
                    && request.resource.data.blockedBy == request.auth.uid;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.blockedBy;
      allow update: if false;
    }

    match /reports/{reportId} {
      allow create: if isSignedIn()
                    && request.resource.data.reportedBy == request.auth.uid
                    && request.resource.data.reportedUid is string
                    && request.resource.data.reason is string
                    && request.resource.data.status == 'open'
                    && (!('messageText' in request.resource.data)
                        || (request.resource.data.messageText is string
                            && request.resource.data.messageText.size() <= 2000));
      allow read, update, delete: if isAdmin();
    }

    // "Report Issue" — anyone can flag a platform bug (separate from
    // reporting another person, above). Rate-limited to one OPEN report at
    // a time per account via the openBugReportByUser existence check, so
    // the create rule can't be satisfied again until an admin resolves or
    // dismisses the pending one (which deletes that flag doc).
    match /bugReports/{reportId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.reportedBy == request.auth.uid);
      allow create: if isSignedIn()
                    && request.resource.data.reportedBy == request.auth.uid
                    && request.resource.data.status == 'open'
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 1000
                    && request.resource.data.text.split(' ').size() <= 50
                    && !exists(/databases/$(database)/documents/openBugReportByUser/$(request.auth.uid));
      allow update, delete: if isAdmin();
    }

    match /openBugReportByUser/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow delete: if isAdmin();
      allow update: if false;
    }

    // Was a flat 3/day for everyone regardless of membership until
    // 2026-08-07 — now shares the same tiered cap as direct messages
    // (dailyMessageLimit above: 10 Free / 30 Gold / unlimited Diamond).
    match /chatMessageLimits/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
                   && request.resource.data.day == today()
                   && request.resource.data.count <= dailyMessageLimit(uid)
                   && (
                        (!exists(/databases/$(database)/documents/chatMessageLimits/$(uid))
                          && request.resource.data.count == 1)
                        ||
                        (exists(/databases/$(database)/documents/chatMessageLimits/$(uid))
                          && resource.data.day != today()
                          && request.resource.data.count == 1)
                        ||
                        (exists(/databases/$(database)/documents/chatMessageLimits/$(uid))
                          && resource.data.day == today()
                          && request.resource.data.count == resource.data.count + 1)
                      );
    }

    match /chatRooms/{roomId}/messages/{messageId} {
      // Same reasoning as users/{uid}/businesses/{uid} above — being
      // signed in was never enough; an unapproved account could read every
      // chat room's messages even though posting was already correctly
      // blocked.
      allow read: if isSignedIn() && (isApproved(request.auth.uid) || isAdmin());
      allow create: if isSignedIn()
                    && (isApproved(request.auth.uid) || isAdmin())
                    // Used to be a hand-enumerated list of every valid room
                    // ID, kept in sync with CHAT_ROOMS in index.html by
                    // hand — a room missing here isn't hidden from the UI,
                    // it just silently rejects every post to it with a
                    // permission error. That happened twice: once when 10
                    // of the original 16 town rooms + 2 topic rooms were
                    // missing, and again when Eufaula Lake's entire town
                    // list (different town names = different room IDs)
                    // wasn't in this Pauls-Valley-specific list at all.
                    // Every real room ID this file ever generates — in any
                    // edition — is lowercase letters/digits/hyphens ending
                    // in "-chat" (see CHAT_ROOMS in index.html: town rooms
                    // are `${town-slug}-chat`, topic rooms are hand-picked
                    // but follow the same shape), so a room list can never
                    // drift out of sync with this check again.
                    && roomId.matches('^[a-z0-9-]+-chat$')
                    && request.resource.data.senderId == request.auth.uid
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 500
                    && request.resource.data.text.split(' ').size() <= 50
                    && isValidChatReply(roomId, request.resource.data);
      allow update: if isSignedIn() && (isApproved(request.auth.uid) || isAdmin()) && (
                      // Toggling a like: only the likes array may change, and it
                      // may only change by adding or removing YOUR OWN uid, one
                      // at a time (the size-delta check blocks tampering with
                      // anyone else's entry in the same write).
                      (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
                        && request.resource.data.likes is list
                        && (
                          (!resource.data.get('likes', []).hasAny([request.auth.uid])
                            && request.resource.data.likes.hasAny([request.auth.uid])
                            && request.resource.data.likes.size() == resource.data.get('likes', []).size() + 1)
                          ||
                          (resource.data.get('likes', []).hasAny([request.auth.uid])
                            && !request.resource.data.likes.hasAny([request.auth.uid])
                            && request.resource.data.likes.size() == resource.data.get('likes', []).size() - 1)
                        ))
                      ||
                      // Toggling a dislike: same idea, dislikes array only.
                      (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dislikes'])
                        && request.resource.data.dislikes is list
                        && (
                          (!resource.data.get('dislikes', []).hasAny([request.auth.uid])
                            && request.resource.data.dislikes.hasAny([request.auth.uid])
                            && request.resource.data.dislikes.size() == resource.data.get('dislikes', []).size() + 1)
                          ||
                          (resource.data.get('dislikes', []).hasAny([request.auth.uid])
                            && !request.resource.data.dislikes.hasAny([request.auth.uid])
                            && request.resource.data.dislikes.size() == resource.data.get('dislikes', []).size() - 1)
                        ))
                    );
      allow delete: if isAdmin();
    }

    match /chessGames/{gameId} {
      // Safe .get(field, default) accessors for inviteTo/participants (not
      // status, which IS the query's own filter field and always defined)
      // — a `list` rule that references fields outside the query's own
      // filter can throw a spurious "Property X is undefined" permission
      // error during list validation on some Firestore emulator versions,
      // even with well-formed data. Confirmed on blackjackGames/
      // airHockeyGames in an earlier pass but never applied to the rest of
      // the game collections sharing this exact same read rule — caught
      // via reproducible test failures (hearts/war/golf/frisbee-golf)
      // against a freshly-restarted emulator, not sustained-load flakiness.
      allow read: if isSignedIn() && (
        (resource.data.get('status', null) == 'open' && resource.data.get('inviteTo', null) == null) ||
        (resource.data.get('inviteTo', null) == request.auth.uid) ||
        (request.auth.uid in resource.data.get('participants', []))
      );
      allow create: if isSignedIn()
                    && (isApproved(request.auth.uid) || isAdmin())
                    && request.resource.data.player1Uid == request.auth.uid
                    && request.resource.data.player2Uid == null
                    && request.resource.data.status == 'open'
                    && request.resource.data.participants == [request.auth.uid]
                    && (
                         request.resource.data.inviteTo == null
                         || !exists(/databases/$(database)/documents/gameInviteLimits/$(request.auth.uid + '_chessGames_' + request.resource.data.inviteTo))
                         || request.time > get(/databases/$(database)/documents/gameInviteLimits/$(request.auth.uid + '_chessGames_' + request.resource.data.inviteTo)).data.lastInvitedAt + duration.value(1, 'h')
                       );
      allow update: if isSignedIn()
                    && (
                      request.auth.uid in resource.data.participants
                      || request.auth.uid == resource.data.player1Uid
                      || request.auth.uid == resource.data.inviteTo
                      || ((isApproved(request.auth.uid) || isAdmin())
                          && resource.data.status == 'open'
                          && resource.data.player2Uid == null
                          && (resource.data.inviteTo == null || resource.data.inviteTo == request.auth.uid))
                    );
      allow delete: if isAdmin()
                    || (isSignedIn() && resource.data.status == 'open' && (
                          request.auth.uid == resource.data.player1Uid
                          || request.auth.uid == resource.data.inviteTo
                        ));
    }

    match /checkersGames/{gameId} {
      // Safe .get(field, default) accessors for inviteTo/participants (not
      // status, which IS the query's own filter field and always defined)
      // — a `list` rule that references fields outside the query's own
      // filter can throw a spurious "Property X is undefined" permission
      // error during list validation on some Firestore emulator versions,
      // even with well-formed data. Confirmed on blackjackGames/
      // airHockeyGames in an earlier pass but never applied to the rest of
      // the game collections sharing this exact same read rule — caught
      // via reproducible test failures (hearts/war/golf/frisbee-golf)
      // against a freshly-restarted emulator, not sustained-load flakiness.
      allow read: if isSignedIn() && (
        (resource.data.get('status', null) == 'open' && resource.data.get('inviteTo', null) == null) ||
        (resource.data.get('inviteTo', null) == request.auth.uid) ||
        (request.auth.uid in resource.data.get('participants', []))
      );
      allow create: if isSignedIn()
                    && (isApproved(request.auth.uid) || isAdmin())
                    && request.resource.data.player1Uid == request.auth.uid
                    && request.resource.data.player2Uid == null
                    && request.resource.data.status == 'open'
                    && request.resource.data.participants == [request.auth.uid]
                    && (
                         request.resource.data.inviteTo == null
                         || !exists(/databases/$(database)/documents/gameInviteLimits/$(request.auth.uid + '_checkersGames_' + request.resource.data.inviteTo))
                         || request.time > get(/databases/$(database)/documents/gameInviteLimits/$(request.auth.uid + '_checkersGames_' + request.resource.data.inviteTo)).data.lastInvitedAt + duration.value(1, 'h')
                       );
      allow update: if isSignedIn()
                    && (
                      request.auth.uid in resource.data.participants
                      || request.auth.uid == resource.data.player1Uid
                      || request.auth.uid == resource.data.inviteTo
                      || ((isApproved(request.auth.uid) || isAdmin())
                          && resource.data.status == 'open'
                          && resource.data.player2Uid == null
                          && (resource.data.inviteTo == null || resource.data.inviteTo == request.auth.uid))
                    );
      allow delete: if isAdmin()
                    || (isSignedIn() && resource.data.status == 'open' && (
                          request.auth.uid == resource.data.player1Uid
                          || request.auth.uid == resource.data.inviteTo
                        ));
    }

    match /wynneGames/{gameId} {
      // Safe .get(field, default) accessors for inviteTo/participants (not
      // status, which IS the query's own filter field and always defined)
      // — a `list` rule that references fields outside the query's own
      // filter can throw a spurious "Property X is undefined" permission
      // error during list validation on some Firestore emulator versions,
      // even with well-formed data. Confirmed on blackjackGames/
      // airHockeyGames in an earlier pass but never applied to the rest of
      // the game collections sharing this exact same read rule — caught
      // via reproducible test failures (hearts/war/golf/frisbee-golf)
      // against a freshly-restarted emulator, not sustained-load flakiness.
      allow read: if isSignedIn() && (
        (resource.data.get('status', null) == 'open' && resource.data.get('inviteTo', null) == null) ||
        (resource.data.get('inviteTo', null) == request.auth.uid) ||
        (request.auth.uid in resource.data.get('participants', []))
      );
      allow create: if isSignedIn()
                    && (isApproved(request.auth.uid) || isAdmin())
                    && request.resource.data.player1Uid == request.auth.uid
                    && request.resource.data.player2Uid == null
                    && request.resource.data.status == 'open'
                    && request.resource.data.participants == [request.auth.uid]
                    && (
                         request.resource.data.inviteTo == null
                         || !exists(/databases/$(database)/documents/gameInviteLimits/$(request.auth.uid + '_wynneGames_' + request.resource.data.inviteTo))
                         || request.time > get(/databases/$(database)/documents/gameInviteLimits/$(request.auth.uid + '_wynneGames_' + request.resource.data.inviteTo)).data.lastInvitedAt + duration.value(1, 'h')
                       );
      allow update: if isSignedIn()
                    && (
                      request.auth.uid in resource.data.participants
                      || request.auth.uid == resource.data.player1Uid
                      || request.auth.uid == resource.data.inviteTo
                      || ((isApproved(request.auth.uid) || isAdmin())
                          && resource.data.status == 'open'
                          && resource.data.player2Uid == null
                          && (resource.data.inviteTo == null || resource.data.inviteTo == request.auth.uid))
                    );
      allow delete: if isAdmin()
                    || (isSignedIn() && resource.data.status == 'open' && (
                          request.auth.uid == resource.data.player1Uid
                          || request.auth.uid == resource.data.inviteTo
                        ));
    }

    match /fgGames/{gameId} {
      // Safe .get(field, default) accessors for inviteTo/participants (not
      // status, which IS the query's own filter field and always defined)
      // — a `list` rule that references fields outside the query's own
      // filter can throw a spurious "Property X is undefined" permission
      // error during list validation on some Firestore emulator versions,
      // even with well-formed data. Confirmed on blackjackGames/
      // airHockeyGames in an earlier pass but never applied to the rest of
      // the game collections sharing this exact same read rule — caught
      // via reproducible test failures (hearts/war/golf/frisbee-golf)
      // against a freshly-restarted emulator, not sustained-load flakiness.
      allow read: if isSignedIn() && (
        (resource.data.get('status', null) == 'open' && resource.data.get('inviteTo', null) == null) ||
        (resource.data.get('inviteTo', null) == request.auth.uid) ||
        (request.auth.uid in resource.data.get('participants', []))
      );
      allow create: if isSignedIn()
                    && (isApproved(request.auth.uid) || isAdmin())
                    && request.resource.data.player1Uid == request.auth.uid
                    && request.resource.data.player2Uid == null
                    && request.resource.data.status == 'open'
                    && request.resource.data.participants == [request.auth.uid]
                    && (
                         request.resource.data.inviteTo == null
                         || !exists(/databases/$(database)/documents/gameInviteLimits/$(request.auth.uid + '_fgGames_' + request.resource.data.inviteTo))
                         || request.time > get(/databases/$(database)/documents/gameInviteLimits/$(request.auth.uid + '_fgGames_' + request.resource.data.inviteTo)).data.lastInvitedAt + duration.value(1, 'h')
                       );
      allow update: if isSignedIn()
                    && (
                      request.auth.uid in resource.data.participants
                      || request.auth.uid == resource.data.player1Uid
                      || request.auth.uid == resource.data.inviteTo
                      || ((isApproved(request.auth.uid) || isAdmin())
                          && resource.data.status == 'open'
                          && resource.data.player2Uid == null
                          && (resource.data.inviteTo == null || resource.data.inviteTo == request.auth.uid))
                    );
      allow delete: if isAdmin()
                    || (isSignedIn() && resource.data.status == 'open' && (
                          request.auth.uid == resource.data.player1Uid
                          || request.auth.uid == resource.data.inviteTo
                        ));
    }

    // War seats 2-4 players in one doc (players/participants are arrays,
    // not fixed player1Uid/player2Uid slots like every other game here) —
    // a direct invite (inviteTo set) is authorized only for the creator and
    // that one named invitee, which naturally caps it at 2 seats without
    // needing a separate size check; an open table (inviteTo == null) can
    // grow up to 4 via the size() < 4 branch below. Move/deal/battle
    // content isn't validated, same trust model as every other game.
    match /warGames/{gameId} {
      // Safe .get(field, default) accessors for inviteTo/participants (not
      // status, which IS the query's own filter field and always defined)
      // — a `list` rule that references fields outside the query's own
      // filter can throw a spurious "Property X is undefined" permission
      // error during list validation on some Firestore emulator versions,
      // even with well-formed data. Confirmed on blackjackGames/
      // airHockeyGames in an earlier pass but never applied to the rest of
      // the game collections sharing this exact same read rule — caught
      // via reproducible test failures (hearts/war/golf/frisbee-golf)
      // against a freshly-restarted emulator, not sustained-load flakiness.
      allow read: if isSignedIn() && (
        (resource.data.get('status', null) == 'open' && resource.data.get('inviteTo', null) == null) ||
        (resource.data.get('inviteTo', null) == request.auth.uid) ||
        (request.auth.uid in resource.data.get('participants', []))
      );
      allow create: if isSignedIn()
                    && (isApproved(request.auth.uid) || isAdmin())
                    && request.resource.data.player1Uid == request.auth.uid
                    && request.resource.data.status == 'open'
                    && request.resource.data.participants == [request.auth.uid]
                    && (
                         request.resource.data.inviteTo == null
                         || !exists(/databases/$(database)/documents/gameInviteLimits/$(request.auth.uid + '_warGames_' + request.resource.data.inviteTo))
                         || request.time > get(/databases/$(database)/documents/gameInviteLimits/$(request.auth.uid + '_warGames_' + request.resource.data.inviteTo)).data.lastInvitedAt + duration.value(1, 'h')
                       );
      allow update: if isSignedIn()
                    && (
                      request.auth.uid in resource.data.participants
                      || request.auth.uid == resource.data.player1Uid
                      || request.auth.uid == resource.data.inviteTo
                      || ((isApproved(request.auth.uid) || isAdmin())
                          && resource.data.status == 'open'
                          && resource.data.inviteTo == null
                          && resource.data.participants.size() < 4)
                    );
      allow delete: if isAdmin()
                    || (isSignedIn() && resource.data.status == 'open' && (
                          request.auth.uid == resource.data.player1Uid
                          || request.auth.uid == resource.data.inviteTo
                        ));
    }

    // Pirates of No Honor — same flexible 2-4 model as warGames (a direct
    // invite caps at 2, an open table caps at 4), for the exact same
    // reason: each player's base/ships/gold are independent, so there's no
    // structural need for every seat to be filled. Unlike warGames, the
    // actual match isn't resolved via a single client transaction — it's a
    // real-time RTS, so the table creator (player1Uid) runs the simulation
    // as "host" and periodically writes the full authoritative state
    // (players[], ghostShips, powerups, etc. — same top-level doc, no
    // content validated, same trust model as every other game here); every
    // other seated player is a read-only "guest" that renders whatever the
    // host publishes and sends its own build/move clicks as tiny documents
    // in the commands subcollection below instead of writing game state
    // directly (guests are never given write access to the parent game
    // doc's simulation fields — only the host and read-only bookkeeping
    // like statsRecorded are ever written by a non-host participant).
    match /piratesGames/{gameId} {
      allow read: if isSignedIn() && (
        (resource.data.get('status', null) == 'open' && resource.data.get('inviteTo', null) == null) ||
        (resource.data.get('inviteTo', null) == request.auth.uid) ||
        (request.auth.uid in resource.data.get('participants', []))
      );
      allow create: if isSignedIn()
                    && (isApproved(request.auth.uid) || isAdmin())
                    && request.resource.data.player1Uid == request.auth.uid
                    && request.resource.data.status == 'open'
                    && request.resource.data.participants == [request.auth.uid]
                    && (
                         request.resource.data.inviteTo == null
                         || !exists(/databases/$(database)/documents/gameInviteLimits/$(request.auth.uid + '_piratesGames_' + request.resource.data.inviteTo))
                         || request.time > get(/databases/$(database)/documents/gameInviteLimits/$(request.auth.uid + '_piratesGames_' + request.resource.data.inviteTo)).data.lastInvitedAt + duration.value(1, 'h')
                       );
      // Once active, only the host (player1Uid) may write the simulation
      // fields — but every participant still needs `update` for their own
      // statsRecorded.{uid} flag once the match finishes, so this can't be
      // narrowed to "host only" outright. Real per-field write protection
      // (host-only for everything except statsRecorded) isn't expressible
      // without a much more complex rule than every other game here uses,
      // so this follows the same "trust the seated players" model as
      // warGames' hands/message/lastReveal fields.
      allow update: if isSignedIn()
                    && (
                      request.auth.uid in resource.data.participants
                      || request.auth.uid == resource.data.player1Uid
                      || request.auth.uid == resource.data.inviteTo
                      || ((isApproved(request.auth.uid) || isAdmin())
                          && resource.data.status == 'open'
                          && resource.data.inviteTo == null
                          && resource.data.participants.size() < 4)
                    );
      allow delete: if isAdmin()
                    || (isSignedIn() && resource.data.status == 'open' && (
                          request.auth.uid == resource.data.player1Uid
                          || request.auth.uid == resource.data.inviteTo
                        ));

      // Guest -> host command relay. A seated player writes their own
      // build/move clicks here; the host's client drains new documents
      // each simulation tick, applies them, then deletes them. Only the
      // AUTHOR may create their own command, and only the host may ever
      // read/delete the queue (guests don't need to see each other's
      // pending clicks, and only the host consumes them).
      match /commands/{commandId} {
        allow create: if isSignedIn()
                      && request.auth.uid in get(/databases/$(database)/documents/piratesGames/$(gameId)).data.participants
                      && request.resource.data.fromUid == request.auth.uid;
        allow read, delete: if isSignedIn()
                      && request.auth.uid == get(/databases/$(database)/documents/piratesGames/$(gameId)).data.player1Uid;
      }
    }

    // Hearts always needs exactly 4 players, so — unlike every other game's
    // invite semantics — a direct invite here does NOT restrict who else
    // can join; it's a courtesy nudge (still reuses the generic Cloud
    // Function trigger), not a private-table gate. Any open table with
    // room can be joined by anyone, invited or not.
    match /heartsGames/{gameId} {
      // Same defensive .get() reasoning as the other game collections above
      // — this rule serves multiple DIFFERENT query shapes (some filter by
      // status, some by participants array-contains, some by inviteTo),
      // and each one leaves a different field "not the query's own filter
      // field" and therefore unsafe to direct-access. Learned the hard way:
      // an earlier pass here left `status` as direct access on the
      // assumption it was always the filtered field, which broke the
      // specific "invites waiting on you" query (filters by inviteTo, not
      // status) the exact same way. Every field this rule touches needs
      // the defensive accessor, not just the ones a given query happens to
      // filter on.
      // Actual root cause of the persisting failure after the .get()-only
      // pass: this rule never had an inviteTo branch at all (unlike every
      // other game here), because Hearts' invites are "a courtesy nudge,
      // not a private-table gate" (see the create/update rules below) —
      // but the client still runs a where('inviteTo','==',uid) query for
      // "invites waiting on you", and Firestore's list validator can't
      // prove a query is safe when NONE of the rule's conditions are tied
      // to the query's own filter field, denying the whole list outright
      // regardless of what any individual matching document contains.
      // Needs a branch referencing inviteTo even though it grants nothing
      // beyond what status=='open' already would in practice.
      allow read: if isSignedIn() && (
        resource.data.get('status', null) == 'open' ||
        (resource.data.get('inviteTo', null) == request.auth.uid) ||
        (request.auth.uid in resource.data.get('participants', []))
      );
      allow create: if isSignedIn()
                    && (isApproved(request.auth.uid) || isAdmin())
                    && request.resource.data.player1Uid == request.auth.uid
                    && request.resource.data.status == 'open'
                    && request.resource.data.participants == [request.auth.uid]
                    && (
                         request.resource.data.inviteTo == null
                         || !exists(/databases/$(database)/documents/gameInviteLimits/$(request.auth.uid + '_heartsGames_' + request.resource.data.inviteTo))
                         || request.time > get(/databases/$(database)/documents/gameInviteLimits/$(request.auth.uid + '_heartsGames_' + request.resource.data.inviteTo)).data.lastInvitedAt + duration.value(1, 'h')
                       );
      allow update: if isSignedIn()
                    && (
                      request.auth.uid in resource.data.participants
                      || request.auth.uid == resource.data.player1Uid
                      || request.auth.uid == resource.data.inviteTo
                      || ((isApproved(request.auth.uid) || isAdmin())
                          && resource.data.status == 'open' && resource.data.participants.size() < 4)
                    );
      allow delete: if isAdmin()
                    || (isSignedIn() && resource.data.status == 'open' && request.auth.uid == resource.data.player1Uid);
    }

    // Same flexible 2-4 model as warGames (not heartsGames' fixed-4): a
    // direct invite is a private table capped at exactly 2, an open table
    // is capped at 4. Each player's hand is independent of the others', so
    // there's no structural need for every seat to be filled.
    match /blackjackGames/{gameId} {
      // Safe .get(field, default) accessors here, not resource.data.inviteTo
      // direct access — this is a `list` (collection query) read rule, and
      // an OR'd rule that references fields outside the query's own filter
      // (only `status` is filtered client-side; `inviteTo`/`participants`
      // aren't) can throw "Property X is undefined" during list validation
      // on some Firestore emulator versions, even when every real document
      // has the field set. Confirmed via isolated reproduction against
      // warGames' identical, already-proven direct-access rule on a fresh
      // local emulator instance — a real emulator quirk, not bad data. The
      // defensive accessor sidesteps it with no behavior change.
      allow read: if isSignedIn() && (
        (resource.data.get('status', null) == 'open' && resource.data.get('inviteTo', null) == null) ||
        (resource.data.get('inviteTo', null) == request.auth.uid) ||
        (request.auth.uid in resource.data.get('participants', []))
      );
      allow create: if isSignedIn()
                    && (isApproved(request.auth.uid) || isAdmin())
                    && request.resource.data.player1Uid == request.auth.uid
                    && request.resource.data.status == 'open'
                    && request.resource.data.participants == [request.auth.uid]
                    && (
                         request.resource.data.inviteTo == null
                         || !exists(/databases/$(database)/documents/gameInviteLimits/$(request.auth.uid + '_blackjackGames_' + request.resource.data.inviteTo))
                         || request.time > get(/databases/$(database)/documents/gameInviteLimits/$(request.auth.uid + '_blackjackGames_' + request.resource.data.inviteTo)).data.lastInvitedAt + duration.value(1, 'h')
                       );
      allow update: if isSignedIn()
                    && (
                      request.auth.uid in resource.data.participants
                      || request.auth.uid == resource.data.player1Uid
                      || request.auth.uid == resource.data.inviteTo
                      || ((isApproved(request.auth.uid) || isAdmin())
                          && resource.data.status == 'open'
                          && resource.data.inviteTo == null
                          && resource.data.participants.size() < 4)
                    );
      allow delete: if isAdmin()
                    || (isSignedIn() && resource.data.status == 'open' && (
                          request.auth.uid == resource.data.player1Uid
                          || request.auth.uid == resource.data.inviteTo
                        ));
    }

    // Strictly 2 players, same player1Uid/player2Uid schema as chessGames
    // (not War/Hearts' array-based seating — Air Hockey never needs more
    // than 2). Real-time match: `puck`/`paddle1`/`paddle2` are written at a
    // throttled ~20Hz by the host (puck+paddle1) and guest (paddle2 only)
    // while status=='playing' — plain updateDoc, not a transaction, since
    // each field is only ever written by one specific player, so there's no
    // write race to resolve.
    match /airHockeyGames/{gameId} {
      // .get(field, default) here, not direct resource.data.field access —
      // a `list` (collection query) rule that references fields outside the
      // query's own filter can throw a spurious "Property X is undefined"
      // permission-denied error on some Firestore emulator versions, even
      // with well-formed data (see blackjackGames' identical comment/fix,
      // confirmed via isolated reproduction against warGames' rule).
      allow read: if isSignedIn() && (
        (resource.data.get('status', null) == 'open' && resource.data.get('inviteTo', null) == null) ||
        (resource.data.get('inviteTo', null) == request.auth.uid) ||
        (request.auth.uid in resource.data.get('participants', []))
      );
      allow create: if isSignedIn()
                    && (isApproved(request.auth.uid) || isAdmin())
                    && request.resource.data.player1Uid == request.auth.uid
                    && request.resource.data.player2Uid == null
                    && request.resource.data.status == 'open'
                    && request.resource.data.participants == [request.auth.uid]
                    && (
                         request.resource.data.inviteTo == null
                         || !exists(/databases/$(database)/documents/gameInviteLimits/$(request.auth.uid + '_airHockeyGames_' + request.resource.data.inviteTo))
                         || request.time > get(/databases/$(database)/documents/gameInviteLimits/$(request.auth.uid + '_airHockeyGames_' + request.resource.data.inviteTo)).data.lastInvitedAt + duration.value(1, 'h')
                       );
      allow update: if isSignedIn()
                    && (
                      request.auth.uid in resource.data.participants
                      || request.auth.uid == resource.data.player1Uid
                      || request.auth.uid == resource.data.inviteTo
                      || ((isApproved(request.auth.uid) || isAdmin())
                          && resource.data.status == 'open'
                          && resource.data.player2Uid == null
                          && (resource.data.inviteTo == null || resource.data.inviteTo == request.auth.uid))
                    );
      allow delete: if isAdmin()
                    || (isSignedIn() && resource.data.status == 'open' && (
                          request.auth.uid == resource.data.player1Uid
                          || request.auth.uid == resource.data.inviteTo
                        ));
    }

    match /golfGames/{gameId} {
      // Safe .get(field, default) accessors for inviteTo/participants (not
      // status, which IS the query's own filter field and always defined)
      // — a `list` rule that references fields outside the query's own
      // filter can throw a spurious "Property X is undefined" permission
      // error during list validation on some Firestore emulator versions,
      // even with well-formed data. Confirmed on blackjackGames/
      // airHockeyGames in an earlier pass but never applied to the rest of
      // the game collections sharing this exact same read rule — caught
      // via reproducible test failures (hearts/war/golf/frisbee-golf)
      // against a freshly-restarted emulator, not sustained-load flakiness.
      allow read: if isSignedIn() && (
        (resource.data.get('status', null) == 'open' && resource.data.get('inviteTo', null) == null) ||
        (resource.data.get('inviteTo', null) == request.auth.uid) ||
        (request.auth.uid in resource.data.get('participants', []))
      );
      allow create: if isSignedIn()
                    && (isApproved(request.auth.uid) || isAdmin())
                    && request.resource.data.player1Uid == request.auth.uid
                    && request.resource.data.player2Uid == null
                    && request.resource.data.status == 'open'
                    && request.resource.data.participants == [request.auth.uid]
                    && (
                         request.resource.data.inviteTo == null
                         || !exists(/databases/$(database)/documents/gameInviteLimits/$(request.auth.uid + '_golfGames_' + request.resource.data.inviteTo))
                         || request.time > get(/databases/$(database)/documents/gameInviteLimits/$(request.auth.uid + '_golfGames_' + request.resource.data.inviteTo)).data.lastInvitedAt + duration.value(1, 'h')
                       );
      allow update: if isSignedIn()
                    && (
                      request.auth.uid in resource.data.participants
                      || request.auth.uid == resource.data.player1Uid
                      || request.auth.uid == resource.data.inviteTo
                      || ((isApproved(request.auth.uid) || isAdmin())
                          && resource.data.status == 'open'
                          && resource.data.player2Uid == null
                          && (resource.data.inviteTo == null || resource.data.inviteTo == request.auth.uid))
                    );
      allow delete: if isAdmin()
                    || (isSignedIn() && resource.data.status == 'open' && (
                          request.auth.uid == resource.data.player1Uid
                          || request.auth.uid == resource.data.inviteTo
                        ));
    }

    match /cribbageGames/{gameId} {
      // Safe .get(field, default) accessors for inviteTo/participants (not
      // status, which IS the query's own filter field and always defined)
      // — a `list` rule that references fields outside the query's own
      // filter can throw a spurious "Property X is undefined" permission
      // error during list validation on some Firestore emulator versions,
      // even with well-formed data. Confirmed on blackjackGames/
      // airHockeyGames in an earlier pass but never applied to the rest of
      // the game collections sharing this exact same read rule — caught
      // via reproducible test failures (hearts/war/golf/frisbee-golf)
      // against a freshly-restarted emulator, not sustained-load flakiness.
      allow read: if isSignedIn() && (
        (resource.data.get('status', null) == 'open' && resource.data.get('inviteTo', null) == null) ||
        (resource.data.get('inviteTo', null) == request.auth.uid) ||
        (request.auth.uid in resource.data.get('participants', []))
      );
      allow create: if isSignedIn()
                    && (isApproved(request.auth.uid) || isAdmin())
                    && request.resource.data.player1Uid == request.auth.uid
                    && request.resource.data.player2Uid == null
                    && request.resource.data.status == 'open'
                    && request.resource.data.participants == [request.auth.uid]
                    && (
                         request.resource.data.inviteTo == null
                         || !exists(/databases/$(database)/documents/gameInviteLimits/$(request.auth.uid + '_cribbageGames_' + request.resource.data.inviteTo))
                         || request.time > get(/databases/$(database)/documents/gameInviteLimits/$(request.auth.uid + '_cribbageGames_' + request.resource.data.inviteTo)).data.lastInvitedAt + duration.value(1, 'h')
                       );
      allow update: if isSignedIn()
                    && (
                      request.auth.uid in resource.data.participants
                      || request.auth.uid == resource.data.player1Uid
                      || request.auth.uid == resource.data.inviteTo
                      || ((isApproved(request.auth.uid) || isAdmin())
                          && resource.data.status == 'open'
                          && resource.data.player2Uid == null
                          && (resource.data.inviteTo == null || resource.data.inviteTo == request.auth.uid))
                    );
      allow delete: if isAdmin()
                    || (isSignedIn() && resource.data.status == 'open' && (
                          request.auth.uid == resource.data.player1Uid
                          || request.auth.uid == resource.data.inviteTo
                        ));

      // Phase 2: each player's hand stays hidden from the opponent until the
      // show phase reveals it into the shared document above — only the
      // owning player can ever read their own private hand doc.
      match /private/{uid} {
        allow read: if isSignedIn() && request.auth.uid == uid;
        allow create: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/cribbageGames/$(gameId)).data.participants;
        // player1's client deals EVERY hand (first and all subsequent), which
        // means re-dealing overwrites an already-existing doc — an update,
        // not a create, in rules terms. A participant other than the doc's
        // own owner may only perform that overwrite when it's structurally a
        // fresh deal (exactly 6 cards, nothing discarded yet); the owner can
        // always update their own doc for anything (discarding, playing a
        // card, etc.).
        allow update: if isSignedIn() && (
          request.auth.uid == uid
          || (request.auth.uid in get(/databases/$(database)/documents/cribbageGames/$(gameId)).data.participants
              && request.resource.data.hand.size() == 6
              && request.resource.data.cribHalf.size() == 0)
        );
      }
    }

    match /stackCheckersGames/{gameId} {
      // Safe .get(field, default) accessors for inviteTo/participants (not
      // status, which IS the query's own filter field and always defined)
      // — a `list` rule that references fields outside the query's own
      // filter can throw a spurious "Property X is undefined" permission
      // error during list validation on some Firestore emulator versions,
      // even with well-formed data. Confirmed on blackjackGames/
      // airHockeyGames in an earlier pass but never applied to the rest of
      // the game collections sharing this exact same read rule — caught
      // via reproducible test failures (hearts/war/golf/frisbee-golf)
      // against a freshly-restarted emulator, not sustained-load flakiness.
      allow read: if isSignedIn() && (
        (resource.data.get('status', null) == 'open' && resource.data.get('inviteTo', null) == null) ||
        (resource.data.get('inviteTo', null) == request.auth.uid) ||
        (request.auth.uid in resource.data.get('participants', []))
      );
      allow create: if isSignedIn()
                    && (isApproved(request.auth.uid) || isAdmin())
                    && request.resource.data.player1Uid == request.auth.uid
                    && request.resource.data.player2Uid == null
                    && request.resource.data.status == 'open'
                    && request.resource.data.participants == [request.auth.uid]
                    && (
                         request.resource.data.inviteTo == null
                         || !exists(/databases/$(database)/documents/gameInviteLimits/$(request.auth.uid + '_stackCheckersGames_' + request.resource.data.inviteTo))
                         || request.time > get(/databases/$(database)/documents/gameInviteLimits/$(request.auth.uid + '_stackCheckersGames_' + request.resource.data.inviteTo)).data.lastInvitedAt + duration.value(1, 'h')
                       );
      allow update: if isSignedIn()
                    && (
                      request.auth.uid in resource.data.participants
                      || request.auth.uid == resource.data.player1Uid
                      || request.auth.uid == resource.data.inviteTo
                      || ((isApproved(request.auth.uid) || isAdmin())
                          && resource.data.status == 'open'
                          && resource.data.player2Uid == null
                          && (resource.data.inviteTo == null || resource.data.inviteTo == request.auth.uid))
                    );
      allow delete: if isAdmin()
                    || (isSignedIn() && resource.data.status == 'open' && (
                          request.auth.uid == resource.data.player1Uid
                          || request.auth.uid == resource.data.inviteTo
                        ));
    }

    match /seaWarGames/{gameId} {
      // Safe .get(field, default) accessors for inviteTo/participants (not
      // status, which IS the query's own filter field and always defined)
      // — a `list` rule that references fields outside the query's own
      // filter can throw a spurious "Property X is undefined" permission
      // error during list validation on some Firestore emulator versions,
      // even with well-formed data. Confirmed on blackjackGames/
      // airHockeyGames in an earlier pass but never applied to the rest of
      // the game collections sharing this exact same read rule — caught
      // via reproducible test failures (hearts/war/golf/frisbee-golf)
      // against a freshly-restarted emulator, not sustained-load flakiness.
      allow read: if isSignedIn() && (
        (resource.data.get('status', null) == 'open' && resource.data.get('inviteTo', null) == null) ||
        (resource.data.get('inviteTo', null) == request.auth.uid) ||
        (request.auth.uid in resource.data.get('participants', []))
      );
      allow create: if isSignedIn()
                    && (isApproved(request.auth.uid) || isAdmin())
                    && request.resource.data.player1Uid == request.auth.uid
                    && request.resource.data.player2Uid == null
                    && request.resource.data.status == 'open'
                    && request.resource.data.participants == [request.auth.uid]
                    && (
                         request.resource.data.inviteTo == null
                         || !exists(/databases/$(database)/documents/gameInviteLimits/$(request.auth.uid + '_seaWarGames_' + request.resource.data.inviteTo))
                         || request.time > get(/databases/$(database)/documents/gameInviteLimits/$(request.auth.uid + '_seaWarGames_' + request.resource.data.inviteTo)).data.lastInvitedAt + duration.value(1, 'h')
                       );
      allow update: if isSignedIn()
                    && (
                      request.auth.uid in resource.data.participants
                      || request.auth.uid == resource.data.player1Uid
                      || request.auth.uid == resource.data.inviteTo
                      || ((isApproved(request.auth.uid) || isAdmin())
                          && resource.data.status == 'open'
                          && resource.data.player2Uid == null
                          && (resource.data.inviteTo == null || resource.data.inviteTo == request.auth.uid))
                    );
      allow delete: if isAdmin()
                    || (isSignedIn() && resource.data.status == 'open' && (
                          request.auth.uid == resource.data.player1Uid
                          || request.auth.uid == resource.data.inviteTo
                        ));
    }

    match /conversations/{conversationId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create, update: if isSignedIn()
                            && request.auth.uid in request.resource.data.participants
                            && request.resource.data.participants.size() == 2;

      match /messages/{messageId} {
        allow read: if isSignedIn() && request.auth.uid in conversationId.split('_');
        allow create: if isSignedIn()
                      && (isApproved(request.auth.uid) || isAdmin())
                      && request.resource.data.senderId == request.auth.uid
                      && request.auth.uid in conversationId.split('_')
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 500
                      && request.resource.data.text.split(' ').size() <= 50
                      && !exists(/databases/$(database)/documents/blocks/$(conversationId));
        allow update, delete: if false;
      }
    }

    // -----------------------------------------------------------------------
    // Daily Rewards — local sponsors (e.g. "Sonic: 1 free shake/day") give
    // out prizes to qualifying users once a day. Split across 4 collections
    // on purpose, for one specific security reason: the coupon code that
    // proves someone won must NEVER be readable by the general public (or
    // anyone could screenshot/redeem someone else's prize), but the WINNER'S
    // NAME/PHOTO/PRIZE must be fully public (that's the whole point of the
    // chat-room winners banner). Firestore can't restrict individual fields
    // within one document, so the public-facing summary and the sensitive
    // full record are two separate documents instead.
    // -----------------------------------------------------------------------

    // One doc per sponsor's giveaway campaign. Only an admin creates/edits
    // these (the admin giveaway form); a sponsor can read their own (for
    // their portal), same isSponsorFor() check used below.
    function isSponsorFor(sponsorId) {
      return isSignedIn()
          && exists(/databases/$(database)/documents/dailyRewardSponsorAccounts/$(request.auth.uid))
          && get(/databases/$(database)/documents/dailyRewardSponsorAccounts/$(request.auth.uid)).data.sponsorId == sponsorId;
    }
    match /dailyRewardSponsors/{sponsorId} {
      allow read: if isAdmin() || isSponsorFor(sponsorId);
      allow write: if isAdmin();
    }

    // The FULL winner record — includes the coupon code and redeemed
    // status, so read access is deliberately narrow: the winner themselves,
    // the specific sponsor whose prize it was, or an admin. Never written by
    // a client at all — only the daily-draw Cloud Function (Admin SDK,
    // bypasses rules) creates these, and only the sponsor-portal Cloud
    // Function (also Admin SDK) flips 'redeemed'. Powers both the sponsor's
    // last-30-days verification page and each user's own 7-day cooldown
    // check (read via Admin SDK server-side, not this rule).
    match /dailyRewardWinners/{winnerId} {
      allow read: if isAdmin()
                  || (isSignedIn() && resource.data.uid == request.auth.uid)
                  || isSponsorFor(resource.data.sponsorId);
      allow write: if false;
    }

    // The PUBLIC summary the chat-room banner actually reads — name, photo,
    // prize, sponsor name/logo, nothing else (no uid, no code). A single
    // fixed doc ID ("current"), overwritten wholesale by the daily-draw
    // function each day — that overwrite IS the "yesterday's winners
    // disappear, today's take their place" rotation, no extra cleanup job
    // needed.
    match /dailyRewardsPublicToday/current {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Maps a sponsor's Firebase Auth account (created via the admin
    // email-invite flow, Admin SDK) to which single sponsorId they're
    // allowed to see — this doc is what isSponsorFor() above checks, and
    // it's the actual enforcement point that keeps one sponsor from ever
    // seeing another's winners/codes, not just a UI restriction. A sponsor
    // never gets a users/{uid} profile at all; this doc is the entirety of
    // their account.
    match /dailyRewardSponsorAccounts/{uid} {
      allow read: if isAdmin() || isOwner(uid);
      allow write: if isAdmin();
    }

    // Outreach admin page (separate repo, townfuss-outreach.web.app) —
    // read-only for the live "next send" countdown and per-lead sent
    // confirmation. Every write to both of these comes from Cloud
    // Functions (Admin SDK, bypasses rules) or the Apps Script senders
    // (plain HTTPS endpoints, also Admin SDK on the receiving end) —
    // never directly from a browser, so there's no client write case to
    // allow here at all.
    match /outreachSettings/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /outreachSentEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
